SCI_DOMAIN=sci.example.com
SCI_APP_ID=123456
# random, 16+ characters: the same value you enter as the GitHub App "Webhook secret"
SCI_WEBHOOK_SECRET=
# random, 20+ characters: the password for the dashboard (user name is ignored)
SCI_ADMIN_TOKEN=
# licence (optional; without one the community limit of 3 repositories applies)
SCI_LICENCE_PUBLIC_KEY=
SCI_LICENCE=
SCI_WORKERS=2
SCI_JOB_TIMEOUT=900
SCI_JOB_MEMORY_MB=4096
SCI_RETENTION_DAYS=90
